---
import '../styles/global.css';

interface Props {
  title: string;
  path?: string;
  description?: string;
}
const {
  title,
  path = '~/logs',
  description = 'My lab notes: what I am learning, breaking and keeping.',
} = Astro.props;

const fullTitle = title === 'Lab Notes' ? '♡ Lab Notes' : `${title} — Lab Notes`;
---
<html lang="en" data-theme="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta name="theme-color" content="#09090a" />

    <!-- tab icon -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <!-- want your profile photo as the tab icon instead? replace the line above with:
    <link rel="icon" href="/profile.jpg" /> -->
    <link rel="apple-touch-icon" href="/profile.jpg" />

    <!-- keep this only if you aren't already loading the font another way -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;700&display=swap" rel="stylesheet" />

    <script is:inline>
      (function () {
        var t;
        try {
          t = localStorage.getItem('theme');
          if (!t) t = matchMedia('(prefers-color-scheme: light)').matches ? 'light' : 'dark';
        } catch (e) { t = 'dark'; }
        document.documentElement.dataset.theme = t;
        var m = document.querySelector('meta[name="theme-color"]');
        if (m) m.setAttribute('content', t === 'light' ? '#f5f5f6' : '#09090a');
      })();
    </script>
  </head>
  <body>
    <div class="term">
      <header class="titlebar">
        <span class="dots" aria-hidden="true"><i></i><i></i><i></i></span>
        <a class="wtitle" href="/">lab-notes <span class="dim">— {path}</span></a>
        <button class="theme-toggle" data-theme-toggle type="button" aria-label="Toggle light and dark theme">
          <span class="t-dark">☾ dark</span><span class="t-light">☼ light</span>
        </button>
      </header>

      <main><slot /></main>

      <footer class="statusbar">
        <span class="sb-mode">♡ LAB</span>
        <span class="sb-path">{path}</span>
        <span class="sb-grow"><slot name="status"><span class="dim">ready</span></slot></span>
        <span class="sb-face">(◕‿◕)</span>
      </footer>
    </div>
  </body>
</html>

<script>
  document.addEventListener('click', (e) => {
    const t = (e.target as HTMLElement).closest('[data-theme-toggle]');
    if (!t) return;
    const next = document.documentElement.dataset.theme === 'light' ? 'dark' : 'light';
    document.documentElement.dataset.theme = next;
    document.querySelector('meta[name="theme-color"]')
      ?.setAttribute('content', next === 'light' ? '#f5f5f6' : '#09090a');
    try { localStorage.setItem('theme', next); } catch {}
  });
</script>